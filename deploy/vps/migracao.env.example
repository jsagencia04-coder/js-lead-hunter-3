# Copie para /srv/js-lead-hunter/migracao.env e preencha.  chmod 600 /srv/js-lead-hunter/migracao.env
# Este arquivo tem senhas: NUNCA envie ao GitHub.

# Banco atual no Supabase em nuvem (o mesmo DATABASE_URL usado pelo worker hoje).
# Use a conexão direta ou o "Session pooler" (porta 5432), nunca a 6543.
CLOUD_DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Domínios (o DNS de ambos precisa apontar para 216.22.17.86)
APP_DOMAIN=leadhunter.jsdesigner.pro
API_DOMAIN=api.leadhunter.jsdesigner.pro

# SMTP para convites e recuperação de senha (provedor externo; não envie pelo IP da VPS)
# Escreva os valores sem aspas. Evite o caractere $ na senha (o Docker o interpreta); se precisar, escreva $$.
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASS=senha
SMTP_ADMIN_EMAIL=nao-responda@jsdesigner.pro
SMTP_SENDER_NAME=JS Lead Hunter

# Pastas (não mude sem necessidade)
BASE_DIR=/srv/js-lead-hunter
SUPABASE_DIR=/srv/js-lead-hunter/supabase
APP_DIR=/srv/js-lead-hunter/app
DUMP_DIR=/srv/js-lead-hunter/migracao
BACKUP_DIR=/srv/js-lead-hunter/backups
DB_CONTAINER=supabase-db

# Backup externo (opcional, mas recomendado): nome de um remoto do rclone, ex.: "gdrive:js-lead-hunter"
RCLONE_REMOTE=
# Senha da criptografia da cópia externa (guarde também fora da VPS; sem ela o backup externo não abre)
BACKUP_GPG_PASSPHRASE=
BACKUP_KEEP_DAYS=14
