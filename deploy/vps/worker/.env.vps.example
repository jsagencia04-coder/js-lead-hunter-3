# Worker na VPS. Copie para .env (mesma pasta) e faça chmod 600 .env. NUNCA envie ao GitHub.

# Banco do Supabase auto-hospedado, pela rede interna do Docker (o host "db" é o container do banco).
# A senha é a POSTGRES_PASSWORD de /srv/js-lead-hunter/supabase/.env
DATABASE_URL=postgresql://postgres:SENHA_DO_POSTGRES@db:5432/postgres

# ---- Fonte oficial (Receita Federal, WebDAV público) ----
RF_MODE=webdav
RF_BASE_URL=https://arquivos.receitafederal.gov.br/public.php/webdav
RF_SHARE_TOKEN=YggdBLfdninEJX9

# ---- Regras de prospecção (mesmas de hoje; a janela pode crescer, pois não há mais o limite de 500 MB) ----
LEAD_WINDOW_DAYS=15
INCLUDE_BRANCHES=false

# ---- Operação ----
CHECK_INTERVAL_HOURS=12
AUTO_IMPORT=true
POLL_SECONDS=30
DOWNLOAD_CONNECTIONS=4          # VPS compartilhada: metade do padrão
DOWNLOAD_CHUNK_MB=8
KEEP_LOCAL_ZIPS=true            # há disco: guardar os ZIPs acelera a retomada
DUCKDB_MEMORY=2GB
DUCKDB_THREADS=2

# Trava de espaço do banco (MB). Ajuste conforme o disco reservado ao Supabase.
DB_SIZE_LIMIT_MB=40000

# ---- Inteligência digital (opcional; sem chave o canal fica "pendente", nunca "não localizado") ----
# GOOGLE_PLACES_API_KEY=
# BRAVE_SEARCH_API_KEY=
